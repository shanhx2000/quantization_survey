# --- papers ---
# Paper PDFs: tens of MB each, not committed. The extracted text IS committed --
# see survey/papers/*/extracted/. Every ANALYSIS.md opens with its download command.
survey/papers/**/*.pdf
survey/uploads/*.pdf
survey/uploads/*.PDF
# Proceedings packages and other bulk sources dropped in uploads/ -- filed, then moved to
# archieve/. These are the only copy of the published ISCA 2026 PDFs, so they are kept on
# disk but never committed. See archieve/README.md.
survey/uploads/*.zip
archieve/*
!archieve/README.md

# HTML snapshots of web resources ARE committed on purpose (pages get taken down);
# see AGENT-GUIDE §3. Do not add *.html here.

# --- the shared team repo ---
# QuantArchSurvey/ is a separate git repo (a clone of shanhx2000/QuantArchSurvey).
# It is NOT ours to edit -- see Claude/instructions/AGENT-GUIDE.md 0b. Never commit it here.
QuantArchSurvey/

# --- the manuscript ---
# latex/ is a separate git repo: a clone of the Overleaf project, pushed and pulled from
# Overleaf directly. Not a submodule. Never commit it here -- see Claude/instructions/LATEX.md.
/latex/

# --- python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- editors / os ---
.vscode/
.idea/
*.swp
.DS_Store

# --- logs ---
*.log
